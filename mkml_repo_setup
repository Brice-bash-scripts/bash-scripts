#!/bin/bash
# ======================================================
# mkml_repo_setup — Sets up a new ML / Backend project repo
# Usage: mkml_repo_setup <repo_name>
# Example: mkml_repo_setup infra_climate_risk_platform
# ======================================================

set -e

if [ -z "$1" ]; then
    echo "❌ Error: No repository name provided."
    echo "Usage: mkml_repo_setup <repo_name>"
    exit 1
fi

REPO_NAME="$1"

echo "🚀 Creating repository: $REPO_NAME"

# ------------------------------------------------------
# Main repository directory
# ------------------------------------------------------

mkdir -p "$REPO_NAME"
cd "$REPO_NAME"

# ------------------------------------------------------
# Core project directories
# ------------------------------------------------------

mkdir -p \
    artifacts \
    data/raw \
    data/processed \
    docker \
    figures \
    logs \
    notebooks \
    results \
    scripts

touch docker/.gitkeep
touch scripts/.gitkeep

# ------------------------------------------------------
# Documentation structure
# ------------------------------------------------------

DOC_DIRS=(
    docs/00_overview
    docs/01_architecture
    docs/02_data
    docs/03_models
    docs/04_api
    docs/05_deployment
    docs/06_operations
    docs/07_security
    docs/08_research
    docs/09_project_diary
)

mkdir -p "${DOC_DIRS[@]}"

for d in "${DOC_DIRS[@]}"; do
    touch "$d/.gitkeep"
done

# ------------------------------------------------------
# Python source structure
# ------------------------------------------------------

PKG="src/$REPO_NAME"

mkdir -p \
    "$PKG/api/auth" \
    "$PKG/api/db" \
    "$PKG/api/routers" \
    "$PKG/api/schemas" \
    "$PKG/api/services" \
    "$PKG/config" \
    "$PKG/core" \
    "$PKG/ml/data" \
    "$PKG/ml/evaluation" \
    "$PKG/ml/features" \
    "$PKG/ml/inference" \
    "$PKG/ml/models" \
    "$PKG/ml/pipelines" \
    "$PKG/ml/visualization" \
    "$PKG/static" \
    "$PKG/templates" \
    "$PKG/utils"

# Top-level package init
touch "$PKG/__init__.py"

# api sub-packages
for d in auth db routers schemas services; do
    touch "$PKG/api/$d/__init__.py"
done

# top-level sub-packages
for d in config core utils; do
    touch "$PKG/$d/__init__.py"
done

# ml sub-packages
for d in data evaluation features inference models pipelines visualization; do
    touch "$PKG/ml/$d/__init__.py"
done

touch "$PKG/static/.gitkeep"
touch "$PKG/templates/.gitkeep"

# ------------------------------------------------------
# Tests
# ------------------------------------------------------

mkdir -p tests/unit tests/integration tests/system

find tests -type d -exec touch {}/__init__.py \;

# ------------------------------------------------------
# Notebook templates
# ------------------------------------------------------

NOTEBOOKS=(
    00_data_ingestion.ipynb
    01_baseline_analysis.ipynb
    02_eda.ipynb
    03_feature_engineering.ipynb
    04_modeling.ipynb
    05_evaluation.ipynb
    06_conclusion.ipynb
)

for nb in "${NOTEBOOKS[@]}"; do
    touch "notebooks/$nb"
done

# ------------------------------------------------------
# Example pipeline scripts
# ------------------------------------------------------

SCRIPTS=(
    download_data.py
    build_features.py
    train_model.py
    evaluate_model.py
    run_pipeline.py
)

for s in "${SCRIPTS[@]}"; do
    touch "scripts/$s"
done

# ------------------------------------------------------
# Root files
# ------------------------------------------------------

touch .env.example
touch README.md

# ------------------------------------------------------
# Gitignore
# ------------------------------------------------------

cat <<EOF > .gitignore
# ==========================================================
# Python
# ==========================================================

__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so
*.pyd
*.dll

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================================================
# Virtual Environments
# ==========================================================

venv/
.venv/
env/
ENV/

# uv environments
.venv-*/
.uv/

# conda environments
conda-meta/
conda-env/
*.conda
*.env

# ==========================================================
# Python Package Managers
# ==========================================================

# pip
pip-log.txt
pip-delete-this-directory.txt

# poetry
poetry.toml

# ==========================================================
# Environment variables / secrets
# ==========================================================

.env
.env.*
*.env

# ==========================================================
# Jupyter
# ==========================================================

.ipynb_checkpoints/
*.nbconvert.ipynb

# ==========================================================
# Data / ML artifacts
# ==========================================================

data/
!$PKG/ml/data
artifacts/*
!artifacts/model.pkl
results/
figures/
logs/

*.h5
*.hdf5
*.model
*.onnx

# ==========================================================
# Testing / coverage
# ==========================================================

.coverage
.coverage.*
.cache
pytest_cache/
htmlcov/

# ==========================================================
# IDE — VSCode
# ==========================================================

.vscode/
.history/

# ==========================================================
# IDE — JetBrains (PyCharm / IntelliJ)
# ==========================================================

.idea/
*.iml
out/

# ==========================================================
# OS files
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================================
# Logs
# ==========================================================

*.log
logs/

# ==========================================================
# Docker
# ==========================================================

docker/*.log
docker/tmp/

# ==========================================================
# Temporary files
# ==========================================================

*.tmp
*.swp
*.swo
*~

# ==========================================================
# Misc
# ==========================================================

.cache/
tmp/
temp/

EOF

# ------------------------------------------------------
# Docker ignore
# ------------------------------------------------------

cat <<EOF > .dockerignore
__pycache__/
*.pyc
*.pyo

.venv/
venv/

.git
.gitignore

data/
artifacts/

tests/
docs/
notebooks/

logs/
results/
figures/

.DS_Store
Thumbs.db
EOF

# ------------------------------------------------------
# Final message
# ------------------------------------------------------

echo ""
echo "✅ Repository '$REPO_NAME' created successfully."
echo ""
echo "Next steps:"
echo "  cd $REPO_NAME"
echo "  git init"
echo ""
echo "Happy building something unnecessarily sophisticated."
