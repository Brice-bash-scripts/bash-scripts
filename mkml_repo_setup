#!/bin/bash
# ======================================================
# mkml_repo_setup — Sets up a new ML / Backend project repo
# Usage: mkml_repo_setup <repo_name>
# Example: mkml_repo_setup infra_climate_risk_platform
# ======================================================

set -e

if [ -z "$1" ]; then
    echo "❌ Error: No repository name provided."
    echo "Usage: mkml_repo_setup <repo_name>"
    exit 1
fi

REPO_NAME="$1"

echo "🚀 Creating repository: $REPO_NAME"

# ------------------------------------------------------
# Main repository directory
# ------------------------------------------------------

mkdir -p "$REPO_NAME"
cd "$REPO_NAME"

# ------------------------------------------------------
# Core project directories
# ------------------------------------------------------

mkdir -p \
src \
tests \
docs \
notebooks \
scripts \
data/raw \
data/processed \
artifacts \
figures \
results \
logs \
docker

touch scripts/.gitkeep

# ------------------------------------------------------
# Python source structure
# ------------------------------------------------------

mkdir -p \
src/"$REPO_NAME"/api \
src/"$REPO_NAME"/core \
src/"$REPO_NAME"/config \
src/"$REPO_NAME"/services \
src/"$REPO_NAME"/schemas \
src/"$REPO_NAME"/utils \
src/"$REPO_NAME"/models \
src/"$REPO_NAME"/db \
src/"$REPO_NAME"/visualization \
src/"$REPO_NAME"/templates \
src/"$REPO_NAME"/static

touch src/"$REPO_NAME"/__init__.py

for d in api core config services schemas utils models db visualization; do
    touch "src/$REPO_NAME/$d/__init__.py"
done

touch src/"$REPO_NAME"/templates/.gitkeep
touch src/"$REPO_NAME"/static/.gitkeep

# ------------------------------------------------------
# Tests
# ------------------------------------------------------

mkdir -p tests/{unit,integration,system}

find tests -type d -exec touch {}/__init__.py \;

# ------------------------------------------------------
# Documentation structure (Improved for scalability)
# ------------------------------------------------------

cd docs

DOC_DIRS=(
00_overview
01_architecture
02_data
03_models
04_api
05_deployment
06_operations
07_security
08_research
09_project_diary
)

mkdir -p "${DOC_DIRS[@]}"

for d in "${DOC_DIRS[@]}"; do
    touch "$d/.gitkeep"
done

cd ..

# ------------------------------------------------------
# Notebook templates
# ------------------------------------------------------

NOTEBOOKS=(
00_data_ingestion.ipynb
01_baseline_analysis.ipynb
02_eda.ipynb
03_feature_engineering.ipynb
04_modeling.ipynb
05_evaluation.ipynb
06_conclusion.ipynb
)

for nb in "${NOTEBOOKS[@]}"; do
    touch "notebooks/$nb"
done

# ------------------------------------------------------
# Example pipeline scripts
# ------------------------------------------------------

SCRIPTS=(
download_data.py
build_features.py
train_model.py
evaluate_model.py
run_pipeline.py
)

for s in "${SCRIPTS[@]}"; do
    touch "scripts/$s"
done

# ------------------------------------------------------
# Environment example
# ------------------------------------------------------

touch .env.example

# ------------------------------------------------------
# Gitignore
# ------------------------------------------------------

cat <<EOF > .gitignore
# ==========================================================
# Python
# ==========================================================

__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so
*.pyd
*.dll

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================================================
# Virtual Environments
# ==========================================================

venv/
.venv/
env/
ENV/

# uv environments
.venv-*/
.uv/

# conda environments
conda-meta/
conda-env/
*.conda
*.env

# ==========================================================
# Python Package Managers
# ==========================================================

# pip
pip-log.txt
pip-delete-this-directory.txt

# poetry
poetry.toml

# ==========================================================
# Environment variables / secrets
# ==========================================================

.env
.env.*
*.env

# ==========================================================
# Jupyter
# ==========================================================

.ipynb_checkpoints/
*.nbconvert.ipynb

# ==========================================================
# Data / ML artifacts
# ==========================================================

data/
artifacts/*
!artifacts/model.pkl
results/
figures/
logs/

*.h5
*.hdf5
*.model
*.onnx

# ==========================================================
# Testing / coverage
# ==========================================================

.coverage
.coverage.*
.cache
pytest_cache/
htmlcov/

# ==========================================================
# IDE — VSCode
# ==========================================================

.vscode/
.history/

# ==========================================================
# IDE — JetBrains (PyCharm / IntelliJ)
# ==========================================================

.idea/
*.iml
out/

# ==========================================================
# OS files
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================================
# Logs
# ==========================================================

*.log
logs/

# ==========================================================
# Docker
# ==========================================================

docker/*.log
docker/tmp/

# ==========================================================
# Temporary files
# ==========================================================

*.tmp
*.swp
*.swo
*~

# ==========================================================
# Misc
# ==========================================================

.cache/
tmp/
temp/

EOF

# ------------------------------------------------------
# Docker ignore
# ------------------------------------------------------

cat <<EOF > .dockerignore
__pycache__/
*.pyc
*.pyo

.venv/
venv/

.git
.gitignore

data/
artifacts/

tests/
docs/
notebooks/

logs/
results/
figures/

.DS_Store
Thumbs.db
EOF

touch docker/.gitkeep

# ------------------------------------------------------
# Final message
# ------------------------------------------------------

echo ""
echo "✅ Repository '$REPO_NAME' created successfully."
echo ""
echo "Next steps:"
echo "cd $REPO_NAME"
echo "git init"
echo ""
echo "Happy building something unnecessarily sophisticated."